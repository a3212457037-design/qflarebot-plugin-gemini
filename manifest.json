{
  "name": "gemini",
  "version": "0.1.0",
  "apiVersion": 4,
  "permissions": [
    "net",
    "kv",
    "db"
  ],
  "depends": {},
  "conflicts": [],
  "commands": [
    {
      "name": "ai",
      "description": "向 AI 提问",
      "usage": "/ai <问题>",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "search",
      "description": "联网搜索并由 AI 整理回答",
      "usage": "/search <关键词>",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "model",
      "description": "查看或切换当前会话模型",
      "usage": "/model [序号|模型ID|default]",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "more",
      "description": "领取长回答剩余正文",
      "usage": "/more",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "reset",
      "description": "清除当前对话历史",
      "usage": "/reset",
      "scenes": [
        "c2c",
        "group"
      ]
    }
  ],
  "regex": [
    {
      "pattern": "\\S",
      "scenes": [
        "c2c",
        "group"
      ],
      "priority": -100,
      "block": false
    }
  ],
  "events": [],
  "buttons": [],
  "cron": [
    {
      "name": "background",
      "cron": "* * * * *"
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/ui/",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/api/probe",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/status",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/api/webhook",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/callback",
      "auth": "public"
    }
  ],
  "hasMiddleware": false,
  "services": [],
  "durableObjects": [],
  "displayName": "Gemini 文本问答",
  "description": "通过 Gemini 进行中文文本问答，支持会话上下文与可选联网搜索",
  "configSchema": {
    "type": "object",
    "properties": {
      "executionMode": {
        "type": "string",
        "title": "推理执行模式",
        "enum": [
          "generateContent",
          "background"
        ],
        "default": "generateContent",
        "description": "普通模式保留原接口；background 在 Google 后台推理，由每分钟 Cron/可选 Webhook 自动回复。先在插件的后台任务页面核验当前 Key 的三个模型权限。需要现有 D1 和每分钟 Cron，群聊回复须在 5 分钟内完成。"
      },
      "model": {
        "type": "string",
        "title": "默认聊天模型",
        "enum": [
          "gemini-3.5-flash-lite",
          "gemini-3.6-flash",
          "gemini-3.8-flash"
        ],
        "default": "gemini-3.5-flash-lite",
        "description": "未单独选择模型的会话跟随此值。聊天用 /model 切换当前会话，/model default 恢复跟随。共用现有 Gemini Key；权限、速度和额度取决于 Google 项目，不会自动换模型或开启计费。"
      },
      "apiKey": {
        "type": "string",
        "title": "Gemini API Key",
        "writeOnly": true,
        "maxLength": 4096,
        "description": "在 [Google AI Studio](https://aistudio.google.com/api-keys) 创建。仅在此设置，不要发送到 QQ。保存后不回显。",
        "default": ""
      },
      "maxInputChars": {
        "type": "integer",
        "title": "问题字符上限",
        "default": 500,
        "minimum": 1,
        "maximum": 1000
      },
      "maxOutputTokens": {
        "type": "integer",
        "title": "生成 Token 上限",
        "default": 65536,
        "minimum": 64,
        "maximum": 65536,
        "description": "默认使用模型官方上限 65536，只是允许的最大输出量；闲聊仍简洁，详细问题再展开。"
      },
      "timeoutMs": {
        "type": "integer",
        "title": "API 超时（毫秒，最多 27000）",
        "default": 27000,
        "minimum": 1000,
        "maximum": 27000,
        "description": "搜索与模型调用合计最多 27 秒，为现有 Worker 的 30 秒后台执行窗口保留发送时间；不能靠提高 Token 上限延长平台执行时间。"
      },
      "ignoredCommandPrefixes": {
        "type": "array",
        "title": "跳过的命令前缀",
        "default": [
          "/"
        ],
        "maxItems": 16,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "description": "普通聊天不会处理这些前缀开头的消息。默认无需更改；若机器人使用自定义命令前缀，请同步填写。SDK 不提供全局前缀读取接口。/ 始终跳过。"
      },
      "enableTavilySearch": {
        "type": "boolean",
        "title": "启用 Tavily 联网搜索",
        "default": false,
        "description": "默认关闭。开启后时效性问题自动搜索，也可用 /search；仅 basic、最多 3 条结果。Google 原生搜索已停用。"
      },
      "tavilyApiKey": {
        "type": "string",
        "title": "Tavily API Key",
        "writeOnly": true,
        "maxLength": 4096,
        "default": "",
        "description": "仅在面板填写，保存后不回显。不会开通付费服务；请在 Tavily 保持 Pay as you go 关闭。"
      }
    },
    "required": [
      "apiKey",
      "maxInputChars",
      "maxOutputTokens",
      "timeoutMs"
    ]
  },
  "defaultConfig": {
    "apiKey": "",
    "model": "gemini-3.5-flash-lite",
    "executionMode": "generateContent",
    "maxInputChars": 500,
    "maxOutputTokens": 65536,
    "timeoutMs": 27000,
    "ignoredCommandPrefixes": [
      "/"
    ],
    "enableGoogleSearch": false,
    "enableTavilySearch": false,
    "tavilyApiKey": ""
  },
  "ui": {
    "path": "/ui/",
    "title": "Gemini 后台任务",
    "icon": "Clock"
  }
}
